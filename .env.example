# Copy to .env and fill in. Never commit real keys.
# --- Browser-safe (publishable) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref
# --- Server-only ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
LOVABLE_API_KEY=            # AI text/voice/image/video gateway (replace with your own provider if leaving Lovable)
ELEVENLABS_API_KEY=         # SFX Maker
TELEGRAM_API_KEY=           # Telegram bot token
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPI_PAYEE_VPA=yourname@bank
UPI_PAYEE_NAME=Modern Nova AI
MUSIC_PROVIDER_URL=         # optional self-hosted music server (POST -> {"audio_url"})
MUSIC_PROVIDER_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=   # Music generation (Google AI Studio Lyria)
MODERN_NOVA_API_KEY=        # Developer API internal key
